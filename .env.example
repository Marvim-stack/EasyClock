EASYMOB_GROUP=
EASYMOB_USER=
EASYMOB_PASSWORD=
# true verifica login e botão sem clicar. false registra de verdade.
DRY_RUN=true
HEADLESS=true
WORK_DAYS=Mon,Tue,Wed,Thu,Fri
# Datas de férias, feriados e folgas: YYYY-MM-DD separadas por vírgula.
EXCLUDED_DATES=
# Opcional: seletor CSS do botão se a identificação pelo texto não funcionar.
EASYMOB_BUTTON_SELECTOR=
# Obrigatório para modo real: seletor CSS de confirmação que só aparece após registrar.
EASYMOB_SUCCESS_SELECTOR=
PORT=3000
# Integração opcional do tipo (select) e valores reais de cada opção no portal.
EASYMOB_TYPE_SELECTOR=
EASYMOB_TYPE_VALUES={}
# Consulta de marcações: URL do mesmo domínio e seletor CSS de uma tabela.
EASYMOB_PUNCHES_URL=
EASYMOB_PUNCHES_SELECTOR=

# Acesso: basta um projeto Supabase Free, sem instalar banco neste computador.
# Use APP_URL=http://localhost:5173 durante npm run dev; 3000 com npm start.
# Não use prefixo VITE_* para segredos. O navegador chama apenas esta API.
APP_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Session pooler do Supabase. Usado pelo admin e para conferir acesso à automação.
DATABASE_URL=
# 32 bytes aleatórios em base64. Preserve esta chave junto do backup de data/.
EASYCLOCK_CREDENTIALS_KEY=

# Cobrança: próxima etapa. O SMTP é configurado diretamente no painel Supabase.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
