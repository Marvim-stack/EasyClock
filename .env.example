EASYMOB_GROUP=
EASYMOB_USER=
EASYMOB_PASSWORD=
# true verifica login e botão sem clicar. false registra de verdade.
DRY_RUN=true
HEADLESS=true
WORK_DAYS=Mon,Tue,Wed,Thu,Fri
# Datas de férias, feriados e folgas: YYYY-MM-DD separadas por vírgula.
EXCLUDED_DATES=
# Opcional: seletor CSS do botão se a identificação pelo texto não funcionar.
EASYMOB_BUTTON_SELECTOR=
# Obrigatório para modo real: seletor CSS de confirmação que só aparece após registrar.
EASYMOB_SUCCESS_SELECTOR=
PORT=3000
# Integração opcional do tipo (select) e valores reais de cada opção no portal.
EASYMOB_TYPE_SELECTOR=
EASYMOB_TYPE_VALUES={}
# Consulta de marcações: URL do mesmo domínio e seletor CSS de uma tabela.
EASYMOB_PUNCHES_URL=
EASYMOB_PUNCHES_SELECTOR=

# Próxima etapa SaaS: inventário de configuração, ainda sem integrações ativas.
# Estas chaves são exclusivas do servidor. Nunca use prefixo VITE_* para segredos.
APP_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
APP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
EASYCLOCK_CREDENTIALS_KEY=
