EASYMOB_GROUP=
EASYMOB_USER=
EASYMOB_PASSWORD=
# true verifica login e botão sem clicar. false registra de verdade.
DRY_RUN=true
HEADLESS=true
WORK_DAYS=Mon,Tue,Wed,Thu,Fri
# Datas de férias, feriados e folgas: YYYY-MM-DD separadas por vírgula.
EXCLUDED_DATES=
# Opcional: seletor CSS do botão se a identificação pelo texto não funcionar.
EASYMOB_BUTTON_SELECTOR=
# Obrigatório para modo real: seletor CSS de confirmação que só aparece após registrar.
EASYMOB_SUCCESS_SELECTOR=
PORT=3000
